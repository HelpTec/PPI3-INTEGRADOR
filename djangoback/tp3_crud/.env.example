# Copiar este archivo como .env y completar con las claves reales
# NUNCA subir el .env al repositorio

# Django
SECRET_KEY=cambiar_por_una_clave_secreta_larga

# IGDB / Twitch — https://dev.twitch.tv (crear aplicación)
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret

# DeepL (plan Free) — https://www.deepl.com/pro#developer
DEEPL_API_KEY=tu_clave_deepl

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_gemini

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
